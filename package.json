{
  "name": "unfolding-machines",
  "version": "1.0.0",
  "private": true,
  "description": "Dev-only harnesses for the Unfolding Machines play aid. The app itself has no build step and no runtime dependencies.",
  "type": "module",
  "scripts": {
    "test": "node tests/harness.mjs",
    "smoke": "node tests/smoke.mjs",
    "audit": "node tests/interaction.mjs",
    "audit:modals": "node tests/audit-modals.mjs",
    "probe:flow": "node tests/probe-flow.mjs",
    "probe": "node tests/probe-layout.mjs",
    "deadcode": "node tests/deadcode.mjs",
    "audit:deep": "node tests/audit-deep.mjs",
    "audit:novice": "node tests/audit-novice.mjs",
    "audit:guide": "node tests/audit-guide.mjs",
    "tutorial": "node tests/tools/gen-tutorial.mjs",
    "pdf": "node tests/tools/gen-pdf.mjs",
    "audit:reach": "node tests/audit-reach.mjs",
    "probe:firstrun": "node tests/probe-firstrun.mjs",
    "cycle": "node tests/cycle.mjs",
    "cycle:watch": "node tests/cycle.mjs --watch",
    "audit:functions": "node tests/audit-functions.mjs",
